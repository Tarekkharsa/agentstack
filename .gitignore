/target
**/*.rs.bk
Cargo.lock.orig

# machine-local overlay — never committed
agentstack.local.toml

# This is the product repo, not a consumer of it: the maintainer's personal
# dogfood manifest and its rendered artifacts stay local. (In YOUR projects,
# committing .agentstack/ is the whole point.)
/agentstack.toml
/agentstack.lock
/.agentstack/
/.mcp.json
/.claude/skills/
/.claude/launch.json
/skills/
/plugins/agentstack/
/.claude-plugin/
/.agents/

# encrypted bundles
*.age

# macOS
.DS_Store
__pycache__/

# workflow scaling bench output — regenerated on every run, not evidence
examples/workflow-scale/results.jsonl

# local playwright install for tools/site-smoke.mjs
/node_modules/
/package.json
/package-lock.json

# review scratch space (handoff notes, throwaway fixtures) — never committed
/.scratch/

# internal planning material — kept on disk for the maintainer, not published
/plan/
/PLAN.md

# archived records nothing current cites — kept on disk and in git history,
# not published. docs/archive/README.md says what keeps the rest tracked.
/docs/archive/BUILD-LOG.md
/docs/archive/FINDINGS-v0.18.0-rc1-review.md
/docs/archive/docs-architecture-proposal.md
/docs/archive/dogfooding-findings.md
/docs/archive/prompt-check-subsystem.md
/docs/archive/spikes/
